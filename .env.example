# ============================================================
# DATABASE (Supabase PostgreSQL)
# ============================================================

# Transaction pooler URL — used by the app at runtime (port 6543)
# IMPORTANT: connection_limit=1 is required for PgBouncer transaction mode to prevent pool exhaustion
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection URL — used by Prisma for migrations only (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# ============================================================
# SUPABASE AUTH & API
# ============================================================

# Your Supabase project URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# Supabase anon/public key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR_ANON_KEY]"

# WARNING: NEVER prefix this with NEXT_PUBLIC_ — it would expose it to the browser
# Only use this in server-side code for admin operations
SUPABASE_SERVICE_ROLE_KEY="[YOUR_SERVICE_ROLE_KEY]"

# ============================================================
# APP CONFIG
# ============================================================

# The URL your app runs on (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Port for local development
PORT=3000

# ============================================================
# DEMO ACCOUNTS (optional — leave unset to disable in production)
# ============================================================

# Password used for all demo@demo.com accounts
DEMO_ACCOUNT_PASSWORD="YourSecureDemoPassword123!"

# Set to "true" to enable demo login buttons in production (leave unset to disable)
# ENABLE_DEMO_ACCOUNTS="true"

# ============================================================
# EMAIL NOTIFICATIONS (optional but recommended for production)
# ============================================================

# Resend API key used by server-side notification emails
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"

# Sender address verified in Resend
FROM_EMAIL="noreply@example.com"
